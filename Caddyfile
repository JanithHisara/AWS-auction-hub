{$DOMAIN} {
    encode zstd gzip

    # Send SSE directly to Express without response buffering.
    @realtime path /api/realtime
    handle @realtime {
        reverse_proxy backend:4000 {
            flush_interval -1
        }
    }

    # Public API and uploads; access control must be implemented by the application.
    @backend path /api/* /uploads/*
    handle @backend {
        reverse_proxy backend:4000
    }

    handle {
        reverse_proxy frontend:3000
    }
}
