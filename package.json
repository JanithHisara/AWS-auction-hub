{
    "name": "gem-auction",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "sst": "sst",
        "deploy": "sst deploy",
        "cdk:synth": "cd cdk && npx cdk synth --profile gem-auction",
        "cdk:diff": "cd cdk && npx cdk diff --profile gem-auction",
