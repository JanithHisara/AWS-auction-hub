{
  "DocumentName": "AWS-RunShellScript",
  "InstanceIds": [
    "i-0eb940cbb790398ab"
  ],
  "Parameters": {
    "commands": [
      "sudo dnf install -y nodejs",
      "mkdir -p /home/ec2-user/prisma-migration",
      "cd /home/ec2-user/prisma-migration",
      "cat << 'EOF' > schema.prisma",
      "generator client {",
      "  provider = "prisma-client-js"",
      "}",
      "",
      "datasource db {",
      "  provider = "postgresql"",
      "  url      = env("DATABASE_URL")",
      "}",
      "",
      "model User {",
      "  id         String   @id @default(uuid()) @db.Uuid",
      "  email      String   @unique",
      "  role       String   @default("user")",
      "  createdAt  DateTime @default(now()) @map("created_at")",
      "",
      "  gems       Gem[]",
      "  bids       Bid[]",
      "  ",
      "  @@map("users")",
      "}",
      "",
      "model Gem {",
      "  id               String   @id @default(uuid()) @db.Uuid",
      "  adminId          String   @db.Uuid @map("admin_id")",
      "  name             String",
      "  description      String",
      "  startingPrice    Decimal  @map("starting_price") @db.Decimal(12, 2)",
      "  minBidIncrement  Decimal  @map("min_bid_increment") @db.Decimal(12, 2)",
      "  startTime        DateTime @map("start_time")",
      "  endTime          DateTime @map("end_time")",
      "  status           String   @default("draft")",
      "  caratWeight      Decimal? @map("carat_weight") @db.Decimal(8, 2)",
      "  cut              String?",
      "  color            String?",
      "  clarity          String?",
      "  provenance       String?",
      "  createdAt        DateTime @default(now()) @map("created_at")",
      "  publishedAt      DateTime? @map("published_at")",
      "",
      "  admin            User     @relation(fields: [adminId], references: [id])",
      "  bids             Bid[]",
      "  ",
      "  @@map("gems")",
      "}",
      "",
      "model Bid {",
      "  id         String   @id @default(uuid()) @db.Uuid",
      "  gemId      String   @db.Uuid @map("gem_id")",
      "  userId     String   @db.Uuid @map("user_id")",
      "  bidAmount  Decimal  @map("bid_amount") @db.Decimal(12, 2)",
      "  createdAt  DateTime @default(now()) @map("created_at")",
      "",
      "  gem        Gem      @relation(fields: [gemId], references: [id])",
      "  user       User     @relation(fields: [userId], references: [id])",
      "",
      "  @@map("bids")",
      "}",
      "EOF",
      "npm install prisma@5 @prisma/client@5",
      "export DATABASE_URL="postgresql://postgres:mLP8S_C20HRB1g-o.mU.q2I-Ic.mk-@auctionhubinfrastack-auroraserverlessv21dd3fd29-avazdjjicbxa.cluster-chww4quqi1bo.ap-south-1.rds.amazonaws.com:5432/postgres"",
      "npx prisma db push --schema=schema.prisma --accept-data-loss"
    ]
  }
}
